---
import type { Chapter } from "../data/story";
import Figure from "./Figure.astro";
import Icon from "./Icon.astro";
import SrsDemo from "./SrsDemo.astro";
import NoteTypeDemo from "./NoteTypeDemo.astro";
interface Props { chapter: Chapter; index: number }
const { chapter: c, index } = Astro.props;
const flip = index % 2 === 1;
---
<section class="chapter" id={c.id} data-chapter data-weight={c.weight ?? "normal"} data-flip={flip ? "" : undefined} aria-labelledby={`${c.id}-title`}>
  <div class="text">
    <p class="year">{c.year}</p>
    <h2 id={`${c.id}-title`}>
      {c.logo && <img class="logo" src={c.logo.src} alt="" width={c.logo.width} height={c.logo.height} />}
      {c.title}
    </h2>
    {c.body.map((p) => <p class="body">{p}</p>)}
    {c.facts && <ul class="facts">{c.facts.map((x) => <li>{x}</li>)}</ul>}
    {c.links && (
      <ul class="links">
        {c.links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener">{l.label}<Icon name="arrow-up-right" size={14} /></a></li>
        ))}
      </ul>
    )}
  </div>
  <div class="art">{c.figure === "notetype-demo" ? <NoteTypeDemo /> : <Figure name={c.figure} />}</div>
  {c.id === "ankidroid" && (
    <div class="extra">
      <h3>Try it: make a card</h3>
      <SrsDemo />
    </div>
  )}
</section>
<style>
  .chapter {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-6);
    align-items: center; padding-block: var(--space-7);
  }
  .chapter[data-flip] { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
  .chapter[data-flip] .text { order: 2; }
  .chapter[data-weight="large"] { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); padding-block: var(--space-8); }
  .chapter[data-weight="large"] .text { max-width: 44rem; }
  .chapter[data-weight="large"] .art { max-width: 64rem; margin-inline: auto; width: 100%; }
  .text { max-width: var(--measure); }
  .extra { grid-column: 1 / -1; }
  .extra h3 { font-size: var(--step-1); }
  .year { font-size: var(--step--1); color: var(--accent); font-weight: 600; letter-spacing: 0.02em; margin-bottom: var(--space-2); }
  h2 { font-size: var(--step-2); margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-3); }
  .chapter[data-weight="large"] h2 { font-size: var(--step-3); }
  .logo { height: 40px; width: auto; border-radius: 9px; flex: none; }
  .body { color: var(--ink-2); }
  .body + .body { margin-top: var(--space-3); }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); list-style: none; padding: 0; margin: var(--space-4) 0 0; color: var(--ink); font-weight: 500; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .links a { display: inline-flex; align-items: center; gap: 4px; font-weight: 500; }

  /* Depth of field: chapters you have not reached sit slightly out of focus. */
  .art { transition: filter 420ms var(--ease), opacity 420ms var(--ease); }
  :global(html.js) .chapter:not([data-active]) .art { filter: blur(3px); opacity: 0.55; }
  :global(html.js) .chapter[data-active] .art { filter: none; opacity: 1; }

  @media (max-width: 820px) {
    .chapter, .chapter[data-flip], .chapter[data-weight="large"] { grid-template-columns: 1fr; gap: var(--space-4); padding-block: var(--space-6); }
    .chapter[data-flip] .text { order: 0; }
    .art { margin-inline: calc(-1 * var(--gutter)); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .chapter:not([data-active]) .art { filter: none; opacity: 1; }
  }
</style>
