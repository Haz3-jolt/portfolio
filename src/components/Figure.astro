---
import { FIGURES } from "../figures/index.mjs";
interface Props { name: string }
const { name } = Astro.props;
const fig = FIGURES[name]();
---
<figure class="fig" data-figure={name} data-live={fig.data ? "" : undefined}>
  <div class="stage" tabindex={fig.data ? 0 : undefined} set:html={fig.svg} />
  {fig.data && <span class="visually-hidden" data-readout aria-live="polite">{fig.readout}</span>}
  {fig.data && <script type="application/json" data-figure-data set:html={JSON.stringify(fig.data)} />}
</figure>
<style>
  .fig { margin: 0; }
  .stage {
    /* The bench runs off both sides; fade its ends so it reads as continuing. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    border-radius: var(--radius);
  }
  .stage :global(svg) { width: 100%; height: auto; overflow: hidden; }
  /* Phones: zoom into the middle of the bench, where the object sits, so it reads at full size. */
  @media (max-width: 640px) {
    .stage { overflow: hidden; -webkit-mask-image: none; mask-image: none; }
    .stage :global(svg) { width: 150%; max-width: none; margin-left: -25%; margin-block: -6% -4%; }
  }
</style>
